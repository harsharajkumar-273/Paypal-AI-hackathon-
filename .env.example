PORT=3001
APP_URL=http://localhost:5173
# Set in deployed environments. Local mode uses embedded PostgreSQL in .data/.
DATABASE_URL=
DATABASE_SSL=false
# Enable the in-process browser worker locally; use a separate worker in production.
RUN_WORKER=true
# PayPal sandbox ONLY. Credentials stay on the server.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Separate strong invite secrets for the real workspace (at least 32 characters each).
DEVELOPER_INVITE=
BUYER_INVITE=
# Comma-separated HTTPS origins controlled by the operator. No arbitrary visitor origins.
ALLOWED_ORIGINS=
# Exact full URL(s) of endpoints authorized to receive verification form submissions.
ALLOWED_FORM_ENDPOINTS=
